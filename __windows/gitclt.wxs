<?xml version='1.0' encoding='windows-1252'?>
<!--
  gitclt: WiX source for the .msi installer, built with
  msitools' `wixl` (Alpine's Windows Installer file toolchain, no
  Windows/.NET/mono needed). Values wrapped in $(var.X) are filled in by the
  Makefile's `wixl -D X=value` flags, sourced from
  ../gitclt.json the same way the rest of this Makefile is,
  except InstallDir, which comes straight from the Makefile's own
  INSTALLDIR variable: edit that to change where this installs.

  UpgradeCode and the Component's Guid below are the two identifiers MSI uses
  to recognize "this is the same product/component across versions", so do
  NOT regenerate them on a future edit. UpgradeCode is this project's
  permanent Windows Installer identity: change it and every future release
  stops being recognized as an upgrade of this one, so a machine ends up with
  two side-by-side installs instead of one replacing the other. The
  Component Guid must stay paired with this exact (install path, key file)
  combination for the same reason, and only needs to change if the installed
  path or the KeyPath file itself changes. Product/@Id='*' is deliberately
  different: wixl mints a fresh ProductCode every build, which is correct,
  since that one identifies this specific build, not the product line.

  stubber generates this file once, at `create` time, with freshly
  random-generated identifiers below. `stubber refresh -w` never re-renders
  an existing one, exactly so these values are never disturbed by accident;
  it only ever creates this file when it is missing.
-->
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
  <Product Name='$(var.ProductName)' Id='*' UpgradeCode='378FFBEC-D528-42CB-9F53-AF353E9FB168'
    Language='1033' Codepage='1252' Version='$(var.ProductVersion)' Manufacturer='$(var.Manufacturer)'>

    <Package Id='*' Keywords='Installer' Description='$(var.Description)'
      Manufacturer='$(var.Manufacturer)' InstallerVersion='200' Languages='1033'
      Compressed='yes' SummaryCodepage='1252' InstallScope='perMachine' />

    <!-- Expands to the Upgrade table + RemoveExistingProducts sequencing:
         installing a newer .msi replaces the old install instead of sitting
         beside it, and installing an older one is refused outright. -->
    <MajorUpgrade DowngradeErrorMessage='A newer version of $(var.ProductName) is already installed.' />

    <!-- Seeds INSTALLDIR with an absolute path (Makefile's INSTALLDIR,
         default C:\utils) instead of the usual ProgramFilesFolder\ProductName
         default CostFinalize would otherwise compute from the Directory
         table below; and since the Directory table has no
         ProgramFilesFolder ancestor at all, no per-product subdirectory
         either: every stubbed tool installs flat into the same directory. -->
    <Property Id='INSTALLDIR' Value='$(var.InstallDir)' />

    <Media Id='1' Cabinet='product.cab' EmbedCab='yes' />

    <Directory Id='TARGETDIR' Name='SourceDir'>
      <Directory Id='INSTALLDIR' Name='INSTALLDIR'>
        <Component Id='MainExecutable' Guid='690615B3-4A01-45DB-86F5-F927051D0B14'>
          <File Id='MainEXE' Name='$(var.BinaryName).exe'
            Source='$(var.Staging)/$(var.BinaryName).exe' KeyPath='yes' />
        </Component>
      </Directory>
    </Directory>

    <Feature Id='Complete' Level='1'>
      <ComponentRef Id='MainExecutable' />
    </Feature>
  </Product>
</Wix>
